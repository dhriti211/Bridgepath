# Copy this file to .env and fill in your keys. Never commit .env.
NEBIUS_API_KEY=
TAVILY_API_KEY=

# Optional: override the Nemotron models used for each job.
# Leave blank to auto-detect from the Token Factory model list.
MODEL_FAST=
MODEL_MEDIUM=
MODEL_REASONING=

# Spend guard: Nebius credits are not a cap, so the app enforces its own.
MAX_LLM_CALLS_PER_DAY=150
MAX_LLM_CALLS_TOTAL=1500
MAX_SEARCHES_PER_DAY=150
RATE_LIMIT_PER_HOUR=20
# live = call Nebius/Tavily within the caps; cached = replay saved examples only, no paid calls
DEMO_MODE=live
